#!/system/bin/sh
# daed-start -- start the daed daemon (dae proxy + web UI).
#
# Callers: service.sh (boot), the Quick-Settings tile (tap = on) and
# daed-watchdog (repair). The daemon is started detached with setsid so it
# survives the caller: a su shell, a TileService thread, or a boot script.
#
# Startup procedure:
#   1. refuse to start a second instance (dae_pids, see below);
#   2. wait for the web UI on 127.0.0.1:2023 (the daemon's readiness signal);
#   3. if the proxy was deliberately stopped (marker file present, the daemon
#      mirrors its DB "running" flag there at startup), report it and leave the
#      run state alone. Resuming the proxy is the web UI's or the Quick-Settings
#      tile's job, and it is a signal, not a reload: SIGUSR2 starts the proxy,
#      SIGUSR1 stops it. A reload would not reliably rebind, cuts in-flight
#      connections and can leave the daemon up with nothing proxied;
#   4. make sure daed-watchdog is running, so a daemon started after boot is
#      self-healed too;
#   5. wait for every interface dae was told to bind to get its tc hooks, and
#      restart the daemon once if they do not show up. dae attaches the hooks
#      some seconds after it answers the web UI, so this waits rather than
#      checking once (see wait_hooks).
#      dae resolves its WAN interface set once per control-plane build, so an
#      uplink that appeared afterwards
#      -- Wi-Fi coming up after boot, Android re-creating the mobile-data
#      interface and moving the default route with it -- is left without hooks:
#      traffic leaving by it is never captured and the proxy dies silently
#      while the web UI, the node health checks and the logs all still look
#      healthy. Which interfaces count is read from daed's own configuration
#      (see must_be_hooked): with wan_interface "auto" that is every interface
#      that is up and carries a default route. The check reads tc rather than
#      the log, because the "Bind to WAN" lines are info-level and the daemon
#      rebuilds its logger from the user's log_level after the first reload
#      (log_level=error here). daed-watchdog's datapath probe is the periodic
#      counterpart of this check.
#
# Exit code 0 when the daemon is up and the web UI answers, 1 otherwise.

BIN="${DAED_BIN:-/data/adb/modules/daed/system/bin/daed}"
WATCHDOG="${DAED_WATCHDOG:-/data/adb/modules/daed/system/bin/daed-watchdog}"
DIR="${DAED_DIR:-/data/adb/daed}"
LOG="$DIR/daed.log"
DB="$DIR/wing.db"
MARKER="$DIR/.dae-stopped"
WLOG="$DIR/watchdog.log"

# Interfaces that are never an uplink, excluded when checking whether every
# uplink is hooked. dummy0 is Android's always-present dummy default route: dae
# does bind it (it is up and has a default route), but nothing real leaves by
# it, and a failure to attach there must not restart the daemon.
NEVER_UPLINK_IFACES="dummy0 lo"

# How long step (5) waits for dae to attach its tc hooks before it calls an
# uplink unhooked: HOOK_POLL_TICKS polls HOOK_POLL_SEC apart. dae answers the
# web UI well before it attaches anything -- on the reference device the UI was
# up at ~1s while the hooks appeared 3-13s after the spawn (measured at boot:
# hooks absent at the moment "daemon up" was logged, present 12s later, the
# datapath already carrying traffic). Checking once, immediately after
# wait_ui, therefore read a healthy boot as a fault: it restarted a working
# daemon on every boot and then warned "still without dae hooks" about a
# datapath that was fine seconds later. Poll up to HOOK_POLL_TICKS *
# HOOK_POLL_SEC seconds instead -- 15 * 2 = 30s, comfortably past the ~13s
# worst case seen, and still bounded so a real failure is reported at boot
# rather than never.
HOOK_POLL_TICKS=15
HOOK_POLL_SEC=2

# The interface lists in daed's sqlite DB, stored as key:"value" text like
# everything else in it (e.g. log_level:"error"). Only wan_interface expands
# "auto" (dae's preprocessWanInterfaceAuto -> common.GetDefaultIfnames);
# lan_interface is a plain list of names.
CONFIG_WAN_KEY="wan_interface"
CONFIG_LAN_KEY="lan_interface"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [daed-start] $*" >>"$WLOG" 2>/dev/null; }

# List the daemon's pids by reading /proc/<pid>/comm, skipping zombies.
#
# `pgrep -x daed` is not usable here: the busybox pgrep that Magisk puts first
# in PATH compares the whole command line even with -x, so it never matches a
# daemon started as "/data/adb/modules/daed/system/bin/daed run -c ...".
# Every liveness test then answered "not running" while the daemon kept
# proxying: the watchdog restarted a healthy daemon on every cooldown, and
# daed-start was willing to start a second instance next to a live one
# ("listen tcp 0.0.0.0:2023: bind: address already in use").
#
# A zombie (state Z) is not a running daemon: it has already exited and only its
# exit status is left for a parent that may never collect it -- which is the
# normal state right after a kill while this very script is between spawn and
# exit. Counting it as alive makes stop_daemon_soft SIGKILL a corpse and then
# report that the daemon would not stop, and makes the start guard refuse to
# start its replacement. stat reads "pid (comm) state ...", so the state is the
# third token -- after the pid and the parenthesized comm, which is a single
# word here ("daed") and so splits cleanly. Anything but an explicit Z counts as
# alive: a stat read that fails (the process vanished in between, or procfs is
# restricted) must not make a running daemon invisible, or the start guard would
# spawn a second instance next to it.
dae_pids() {
    for d in /proc/[0-9]*; do
        [ "$(cat "$d/comm" 2>/dev/null)" = "daed" ] || continue
        _dp_state=S
        read -r _dp_id _dp_comm _dp_state _dp_rest <"$d/stat" 2>/dev/null
        [ "$_dp_state" = "Z" ] || echo "${d#/proc/}"
    done
}

# Interfaces carrying a default route right now: the ones traffic can leave by.
# operstate is not usable for this -- Android's rmnet interfaces report
# "unknown" while carrying the default route -- so the routing table is what
# gets read. daed-watchdog carries the same helper on purpose: the two scripts
# must each work standalone out of the module's bin directory.
default_route_ifaces() {
    ip route show table all 2>/dev/null | grep '^default' \
        | sed -n 's/.*dev \([a-zA-Z0-9_.-]*\).*/\1/p' | sort -u
}

# Number of dae tc-bpf filters attached to $1, ingress plus egress; non-zero
# means traffic leaving by it is captured.
dae_hooks() {
    [ -e "/sys/class/net/$1" ] || return 1
    _dh_i=$(tc filter show dev "$1" ingress 2>/dev/null | grep -c daed_)
    _dh_e=$(tc filter show dev "$1" egress 2>/dev/null | grep -c daed_)
    echo $(( _dh_i + _dh_e ))
}

# Was dae told to bind $1? Read from daed's own configuration, so that the check
# only ever demands hooks where dae itself promised them:
#   * wan_interface "auto" means every interface that is up and carries a default
#     route (common.GetDefaultIfnames) -- i.e. every interface this script
#     checks, so all of them must be hooked;
#   * a named list means exactly the names in it.
# An interface dae was never told to bind is left alone: restarting would not
# hook it either, it would only cut the connections in flight.
must_be_hooked() {
    [ -f "$DB" ] || return 1
    _mb_wan=$(grep -a -o "$CONFIG_WAN_KEY:\"[^\"]*\"" "$DB" 2>/dev/null | tail -1)
    case "$_mb_wan" in
        *auto*) return 0 ;;
    esac
    _mb_lan=$(grep -a -o "$CONFIG_LAN_KEY:\"[^\"]*\"" "$DB" 2>/dev/null | tail -1)
    for _mb_frag in "$_mb_wan" "$_mb_lan"; do
        [ -n "$_mb_frag" ] || continue
        case "$_mb_frag" in
            *"$1"*) return 0 ;;
        esac
    done
    return 1
}

# The uplinks to check: the current default-route interfaces that dae was told
# to bind, minus NEVER_UPLINK_IFACES.
required_uplinks() {
    for _ru_i in $(default_route_ifaces); do
        case " $NEVER_UPLINK_IFACES " in
            *" $_ru_i "*) continue ;;
        esac
        must_be_hooked "$_ru_i" && printf '%s ' "$_ru_i"
    done
}

# The ones among them that have no dae hook at all, i.e. the interfaces traffic
# leaves by without being captured.
unhooked_uplinks() {
    for _uu_i in $(required_uplinks); do
        _uu_n=$(dae_hooks "$_uu_i") || continue
        [ "$_uu_n" = "0" ] && printf '%s ' "$_uu_i"
    done
}

# Poll unhooked_uplinks until it comes back empty or the deadline passes.
# Returns 0 when every required uplink is hooked, 1 when some are still not,
# and leaves the last answer in HOOK_MISSING either way (empty on success).
#
# This is a wait, not a check, because the hooks are attached by the daemon
# some seconds after it answers the web UI: reading the state once right after
# wait_ui is reading it too early, and the cost of being wrong is a restarted
# daemon plus a false warning on a datapath that was never broken. The wait is
# bounded, so a daemon that genuinely cannot attach still gets its restart and
# its warning -- just after the uplinks have had their chance.
wait_hooks() {
    HOOK_MISSING=""
    _wh_i=0
    while :; do
        HOOK_MISSING=$(unhooked_uplinks)
        [ -z "$HOOK_MISSING" ] && return 0
        [ "$_wh_i" -ge "$HOOK_POLL_TICKS" ] && return 1
        sleep "$HOOK_POLL_SEC"
        _wh_i=$(( _wh_i + 1 ))
    done
}

spawn_daemon() {
    log "starting daemon"
    cd "$DIR" || return 1
    setsid "$BIN" run -c "$DIR" >>"$LOG" 2>&1 </dev/null &
}

# Wait for the web UI on 127.0.0.1:2023, the daemon's readiness signal; UI_CODE
# carries the last answer for the caller's message.
wait_ui() {
    UI_CODE=""
    _wu_i=0
    while [ "$_wu_i" -lt 40 ]; do
        UI_CODE=$(curl -s -m 2 -o /dev/null -w '%{http_code}' http://127.0.0.1:2023/ 2>/dev/null)
        [ "$UI_CODE" = "200" ] && return 0
        sleep 1
        _wu_i=$((_wu_i + 1))
    done
    return 1
}

# SIGTERM the daemon and wait for it to go, so that a fresh start re-resolves
# the interface set. Deliberately not daed-stop: that writes the "switched off"
# marker, which would leave the proxy stopped instead of restarted.
stop_daemon_soft() {
    for _sd_p in $(dae_pids); do kill -15 "$_sd_p" 2>/dev/null; done
    _sd_i=0
    while [ "$_sd_i" -lt 20 ]; do
        [ -z "$(dae_pids)" ] && return 0
        sleep 0.5
        _sd_i=$((_sd_i + 1))
    done
    log "SIGTERM timed out during restart; sending SIGKILL"
    for _sd_p in $(dae_pids); do kill -9 "$_sd_p" 2>/dev/null; done
    sleep 1
    [ -z "$(dae_pids)" ]
}

mkdir -p "$DIR" 2>/dev/null

if [ ! -x "$BIN" ]; then
    echo "daed-start: daed binary missing: $BIN" >&2
    log "FATAL binary missing: $BIN"
    exit 1
fi

if [ -n "$(dae_pids)" ]; then
    echo "daed-start: already running (pid $(dae_pids | tr '\n' ' '))"
else
    spawn_daemon
fi

# (2) wait for the web UI
if ! wait_ui; then
    echo "daed-start: web UI did not come up (last http_code=${UI_CODE:-none})" >&2
    log "FAILED web UI did not come up (last http_code=${UI_CODE:-none})"
    exit 1
fi
echo "daed-start: daemon up (pid $(dae_pids | tr '\n' ' ')), web UI http_code=$UI_CODE"

# (3) proxy stopped in the DB -> request run
if [ -f "$MARKER" ]; then
    log "proxy stop marker present; run state is left to the web UI (signals would rebuild an empty control plane)"
    sleep 2
fi

# (4) keep the self-heal loop alive
if [ -x "$WATCHDOG" ] && ! pgrep -f "daed-watchdog" >/dev/null 2>&1; then
    log "starting watchdog"
    setsid "$WATCHDOG" >>"$WLOG" 2>&1 </dev/null &
fi

# (5) every uplink dae was told to bind must have its hooks
#
# Skipped while the proxy is deliberately stopped: dae detaches its BPF hooks on
# shutdown, so missing hooks are the expected state then, not a fault.
if [ -f "$MARKER" ]; then
    log "proxy stop marker present; skipping the uplink hook check"
elif ! command -v tc >/dev/null 2>&1; then
    log "tc not available; skipping the uplink hook check"
else
    UPLINKS=$(required_uplinks)
    if [ -z "$UPLINKS" ]; then
        echo "daed-start: no uplink of dae's to check right now"
        log "no current default-route interface is one dae binds; skipping the uplink hook check"
    else
        if wait_hooks; then
            echo "daed-start: uplinks all hooked [$(printf '%s ' $UPLINKS)]"
            log "uplinks all hooked [$(printf '%s ' $UPLINKS)]"
        else
            # Restarting re-resolves dae's interface set. Deliberately not a
            # loop: one restart, then either the uplinks are hooked or the
            # warning stands (a daemon that cannot attach there at all is not
            # helped by trying again).
            echo "daed-start: uplink(s) without dae hooks after $((HOOK_POLL_TICKS * HOOK_POLL_SEC))s:$HOOK_MISSING -- restarting the daemon once"
            log "uplink(s) without dae hooks after $((HOOK_POLL_TICKS * HOOK_POLL_SEC))s:$HOOK_MISSING -- restarting the daemon once"
            if stop_daemon_soft && spawn_daemon && wait_ui; then
                echo "daed-start: restarted (web UI http_code=$UI_CODE)"
                log "restarted; web UI http_code=$UI_CODE"
                UPLINKS=$(required_uplinks)
                if wait_hooks; then
                    echo "daed-start: uplinks all hooked after the restart [$(printf '%s ' $UPLINKS)]"
                    log "uplinks all hooked after the restart [$(printf '%s ' $UPLINKS)]"
                else
                    echo "daed-start: WARNING still without dae hooks after the restart:$HOOK_MISSING" >&2
                    log "WARNING still without dae hooks after the restart:$HOOK_MISSING"
                fi
            else
                echo "daed-start: FAILED restart did not bring the web UI up" >&2
                log "FAILED restart did not bring the web UI up (last http_code=${UI_CODE:-none})"
                exit 1
            fi
        fi
    fi
fi

exit 0
