#!/system/bin/sh
# daed-start -- start the daed daemon (dae proxy + web UI).
#
# Callers: service.sh (boot), the Quick-Settings tile (tap = on) and
# daed-watchdog (repair). The daemon is started detached with setsid so it
# survives the caller: a su shell, a TileService thread, or a boot script.
#
# Startup procedure:
#   1. refuse to start a second instance (dae_pids, see below);
#   2. wait for the web UI on 127.0.0.1:2023 (the daemon's readiness signal);
#   3. if the proxy was deliberately stopped (marker file present, the daemon
#      mirrors its DB "running" flag there at startup), report it and leave the
#      run state alone. Resuming the proxy is the web UI's or the Quick-Settings
#      tile's job: SIGUSR2 suspends dae and SIGUSR1 makes it rebuild an empty
#      control plane, which is what used to produce a "daemon is up but nothing
#      is proxied" datapath;
#   4. make sure daed-watchdog is running, so a daemon started after boot is
#      self-healed too;
#   5. print the WAN binding vs. the interfaces carrying a default route when
#      that can be read from the log. It often cannot: the Bind lines are
#      info-level and the daemon rebuilds its logger from the user's log_level
#      after the first reload (this device runs log_level=error). Whether the
#      datapath actually works is decided by daed-watchdog's probe instead.
#
# Exit code 0 when the daemon is up and the web UI answers, 1 otherwise.

BIN="${DAED_BIN:-/data/adb/modules/daed/system/bin/daed}"
WATCHDOG="${DAED_WATCHDOG:-/data/adb/modules/daed/system/bin/daed-watchdog}"
DIR="${DAED_DIR:-/data/adb/daed}"
LOG="$DIR/daed.log"
MARKER="$DIR/.dae-stopped"
WLOG="$DIR/watchdog.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [daed-start] $*" >>"$WLOG" 2>/dev/null; }

# List the daemon's pids by reading /proc/<pid>/comm.
#
# `pgrep -x daed` is not usable here: the busybox pgrep that Magisk puts first
# in PATH compares the whole command line even with -x, so it never matches a
# daemon started as "/data/adb/modules/daed/system/bin/daed run -c ...".
# Every liveness test then answered "not running" while the daemon kept
# proxying: the watchdog restarted a healthy daemon on every cooldown, and
# daed-start was willing to start a second instance next to a live one
# ("listen tcp 0.0.0.0:2023: bind: address already in use").
dae_pids() {
    for d in /proc/[0-9]*; do
        [ "$(cat "$d/comm" 2>/dev/null)" = "daed" ] && echo "${d#/proc/}"
    done
}

mkdir -p "$DIR" 2>/dev/null

if [ ! -x "$BIN" ]; then
    echo "daed-start: daed binary missing: $BIN" >&2
    log "FATAL binary missing: $BIN"
    exit 1
fi

if [ -n "$(dae_pids)" ]; then
    echo "daed-start: already running (pid $(dae_pids | tr '\n' ' '))"
else
    log "starting daemon"
    cd "$DIR" || exit 1
    setsid "$BIN" run -c "$DIR" >>"$LOG" 2>&1 </dev/null &
fi

# (2) wait for the web UI
code=""
i=0
while [ "$i" -lt 40 ]; do
    code=$(curl -s -m 2 -o /dev/null -w '%{http_code}' http://127.0.0.1:2023/ 2>/dev/null)
    [ "$code" = "200" ] && break
    sleep 1
    i=$((i + 1))
done
if [ "$code" != "200" ]; then
    echo "daed-start: web UI did not come up (last http_code=${code:-none})" >&2
    log "FAILED web UI did not come up (last http_code=${code:-none})"
    exit 1
fi
echo "daed-start: daemon up (pid $(dae_pids | tr '\n' ' ')), web UI http_code=$code"

# (3) proxy stopped in the DB -> request run
if [ -f "$MARKER" ]; then
    log "proxy stop marker present; run state is left to the web UI (signals would rebuild an empty control plane)"
    sleep 2
fi

# (4) keep the self-heal loop alive
if [ -x "$WATCHDOG" ] && ! pgrep -f "daed-watchdog" >/dev/null 2>&1; then
    log "starting watchdog"
    setsid "$WATCHDOG" >>"$WLOG" 2>&1 </dev/null &
fi

# (5) informational binding report, when the log happens to carry it
HC=$(grep -n 'Health check will only verify' "$LOG" 2>/dev/null | tail -1 | cut -d: -f1)
BOUND=""
if [ -n "$HC" ]; then
    BOUND=$(tail -n +"$HC" "$LOG" 2>/dev/null | grep 'Bind to WAN' \
        | sed 's/.*Bind to WAN: //' | tr -d '"' | sort -u | tr '\n' ' ')
fi
if [ -z "$BOUND" ]; then
    echo "daed-start: WAN binding unknown (Bind lines are info-level; log_level hides them)"
else
    DEFAULT_IFS=$(ip route show table all 2>/dev/null | grep '^default' \
        | sed -n 's/.*dev \([a-zA-Z0-9_.-]*\).*/\1/p' | sort -u | tr '\n' ' ')
    echo "daed-start: default-route ifaces: [$DEFAULT_IFS]"
    echo "daed-start: bound WAN ifaces:     [$BOUND]"
    STALE=""
    for d in $DEFAULT_IFS; do
        case " $BOUND " in
            *" $d "*) ;;
            *) STALE="$STALE $d" ;;
        esac
    done
    if [ -n "$STALE" ]; then
        echo "daed-start: note not bound as WAN:$STALE"
        log "note default-route iface(s) not bound as WAN:$STALE"
    fi
fi

exit 0
