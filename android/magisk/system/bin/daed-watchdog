#!/system/bin/sh
# daed-watchdog -- keep daed usable without user interaction.
#
# The watchdog does NOT restart anything on a schedule. Every INTERVAL seconds
# it only *reads* state; a repair happens when one of these is true:
#
#   * the daemon is gone (crash, OOM kill, manual kill);
#   * the web UI on 127.0.0.1:2023 stopped answering;
#   * the datapath stopped carrying traffic (see the probe below) -- this is
#     the failure the watchdog exists for: Android re-creates the mobile-data
#     interface (rmnet_data4 -> rmnet_data3/5) and moves the default route
#     with it, while dae resolves its WAN/LAN interface set only once per
#     control-plane build. Its tc/eBPF hooks then sit on interfaces nothing
#     flows through any more: app traffic is never captured, the proxy dies
#     silently, and the web UI, the node health checks and the logs all still
#     look healthy.
#
# A repair is a daemon *restart* (daed-stop + daed-start); a fresh start
# re-detects the interfaces. A reload is deliberately not used: it does not
# reliably rebind, it cuts in-flight connections and it can wedge the datapath
# ("handleConn: failed to retrieve target info ... context canceled").
#
# How the datapath probe works (and why not simpler tests):
#   * "grep the Bind lines" is not usable: they are info-level, and the daemon
#     rebuilds its logger from the user's log_level after the first reload, so
#     they disappear (log_level is "error" on this device).
#   * "can I reach a blocked site" is not usable either: some networks do not
#     block it, and then a dead proxy still looks healthy.
#   So the probe measures the effect: fetch a page from a host that the routing
#   rules send through the proxy, as a *non-root* uid, and watch dae0. dae0 is
#   the veth dae hands a flow to when it takes the flow over, hence
#       page loads, dae0 moved     -> the flow was handed to dae
#       nothing loads, dae0 at 0   -> nothing was captured: datapath broken
#   uid 0 is exempted from dae by the Android patch, so the probe has to run as
#   a non-root uid; uid 2000 (shell) is used and needs no resolver of its own.
#
# Why the probe targets are pinned addresses and not a host name:
#   a name would have to be resolved by the root shell here, and root bypasses
#   dae (uid 0 is exempt), so a blocked name comes back poisoned. A poisoned
#   answer is normally mainland space, mainland space is routed direct, and a
#   direct flow is passed through at the capture point without ever touching
#   dae0 ("we don't save state for direct+mark==0", tproxy.c). Resolving would
#   therefore make the probe read "dae0 did not move" on a datapath that works
#   perfectly. With real addresses of a blocked host, "goes through the proxy"
#   is the only possibility: either dae0 moves, or the datapath really is down.
#   PROBE_IPS ages: if the probe starts failing on a datapath known to work,
#   refresh the list from a working resolver (through the proxy, or DoH).
#
# Guard rails, so the cure is never worse than the disease:
#   * repairs are skipped while the user switched the daemon off (marker file);
#   * probing is skipped only while dae is bound to nothing that is currently an
#     uplink -- with wan_interface "auto" every current uplink is bound, so the
#     probe always applies (see NEVER_UPLINK_IFACES / CONFIG_* below);
#   * the probe must fail PROBE_FAILS times in a row before anything happens;
#   * a repair waits until dae0 has carried no traffic for IDLE_SAMPLES x
#     IDLE_SAMPLE_SEC seconds, so an in-flight download is not interrupted;
#   * at least HEAL_COOLDOWN seconds between two repairs;
#   * if a repair does not actually fix the probe, the watchdog backs off for
#     BACKOFF seconds instead of retrying every HEAL_COOLDOWN. The backoff is
#     tied to the boot it was recorded on (see boot_ident), so a reboot clears
#     it: after one, the state that verdict was about is gone -- interfaces and
#     routes have been rebuilt, and a flash may have removed the very fault the
#     repairs could not fix -- so staying quiet would only hide a datapath that
#     is repairable again.
#
# Optional config: /data/adb/daed/watchdog.conf, plain KEY=VALUE lines, e.g.
#     WATCH_INTERVAL=30
#     PROBE_INTERVAL=300
#     PROBE_FAILS=2
#     HEAL_COOLDOWN=600
#     BACKOFF=21600
#     IDLE_SAMPLES=3
#     IDLE_SAMPLE_SEC=5
#     NEVER_UPLINK_IFACES="dummy0 lo"
#     CONFIG_IFACE_KEYS="wan_interface lan_interface"
#     CONFIG_WAN_KEY="wan_interface"
#     PROBE_IPS="142.251.34.67 142.250.185.78 172.217.163.46"
#     PROBE_SNI="www.gstatic.com"
#     PROBE_URL="https://www.gstatic.com/generate_204"
#     PROBE_EXPECT="204"
#     CTRL_HOST="www.baidu.com"
#     CTRL_URL="https://www.baidu.com/"
#
# Usage: daed-watchdog [interval_seconds] [--once]

DIR="${DAED_DIR:-/data/adb/daed}"
BIN_DIR="${DAED_BIN_DIR:-/data/adb/modules/daed/system/bin}"
DB="$DIR/wing.db"
LOG="$DIR/daed.log"
MARKER="$DIR/.dae-stopped"
WLOG="$DIR/watchdog.log"
CONF="$DIR/watchdog.conf"
LASTHEAL="$DIR/.watchdog-last-heal"
BACKOFF_UNTIL="$DIR/.watchdog-backoff-until"
DAE0_STATS="/sys/class/net/dae0/statistics"

WATCH_INTERVAL=30
PROBE_INTERVAL=300
PROBE_FAILS=2
HEAL_COOLDOWN=600
BACKOFF=21600
IDLE_SAMPLES=3
IDLE_SAMPLE_SEC=5
# Interfaces that are never an uplink, excluded when scanning for the ones
# traffic can actually leave by. dummy0 is Android's always-present dummy
# default route: counting it would make that scan always find "an uplink".
# (An older conf may still set IGNORE_IFACES / WIFI_IFACES; both are gone --
# that gate asked whether Wi-Fi was up, not whether anything was proxied.)
NEVER_UPLINK_IFACES="dummy0 lo"
CONFIG_IFACE_KEYS="wan_interface lan_interface"
# The one key whose value dae expands: "auto" there means every up interface
# with a default route (see config_binds_iface).
CONFIG_WAN_KEY="wan_interface"
# Probe targets: PROBE_* must be routed through the proxy, CTRL_* must work
# without the proxy (used to tell "no network" from "proxy broken").
# PROBE_IPS are real addresses of PROBE_SNI, pinned on purpose -- see the header.
PROBE_IPS="142.251.34.67 142.250.185.78 172.217.163.46"
PROBE_SNI="www.gstatic.com"
PROBE_URL="https://www.gstatic.com/generate_204"
PROBE_EXPECT="204"
# CTRL_* is only used to tell "uid 2000 has no network at all" from "the proxy
# path is broken", so it is the one target that may be resolved: a mainland name
# stays reachable even when its answer is poisoned.
CTRL_HOST="www.baidu.com"
CTRL_URL="https://www.baidu.com/"
[ -f "$CONF" ] && . "$CONF"

ONCE=0
for a in "$@"; do
    case "$a" in
        --once) ONCE=1 ;;
        *[!0-9]*) ;;
        "") ;;
        *) WATCH_INTERVAL="$a" ;;
    esac
done

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [watchdog] $*" >>"$WLOG" 2>/dev/null; }

# List the daemon's pids by reading /proc/<pid>/comm, skipping zombies.
#
# `pgrep -x daed` is not usable here: the busybox pgrep that Magisk puts first
# in PATH compares the whole command line even with -x, so it never matches a
# daemon started as "/data/adb/modules/daed/system/bin/daed run -c ...".
# Every liveness test then answered "not running" while the daemon kept
# proxying: the watchdog restarted a healthy daemon on every cooldown, and
# daed-start was willing to start a second instance next to a live one
# ("listen tcp 0.0.0.0:2023: bind: address already in use").
#
# A zombie (state Z) has already exited -- only its exit status is left, for a
# parent that may never collect it. Reporting it as a running daemon hides a
# dead one, and the repair that follows (daed-stop + daed-start) then fails: the
# start guard sees the corpse as "already running" and spawns nothing. stat reads
# "pid (comm) state ...", so the state is the third token -- after the pid and the
# parenthesized comm, which is a single word here ("daed") and splits cleanly.
# Anything but an explicit Z counts as alive: a stat read that fails must not
# make a running daemon invisible.
dae_pids() {
    for d in /proc/[0-9]*; do
        [ "$(cat "$d/comm" 2>/dev/null)" = "daed" ] || continue
        _dp_state=S
        read -r _dp_id _dp_comm _dp_state _dp_rest <"$d/stat" 2>/dev/null
        [ "$_dp_state" = "Z" ] || echo "${d#/proc/}"
    done
}

daemon_pid() { dae_pids | head -1; }

ui_ok() {
    [ "$(curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:2023/ 2>/dev/null)" = "200" ]
}

dae0_total() {
    rx=$(cat "$DAE0_STATS/rx_bytes" 2>/dev/null)
    tx=$(cat "$DAE0_STATS/tx_bytes" 2>/dev/null)
    echo $(( ${rx:-0} + ${tx:-0} ))
}

# 0 when dae0 carried no traffic for IDLE_SAMPLES x IDLE_SAMPLE_SEC seconds.
dae0_idle() {
    prev=$(dae0_total)
    n=0
    while [ "$n" -lt "$IDLE_SAMPLES" ]; do
        sleep "$IDLE_SAMPLE_SEC"
        cur=$(dae0_total)
        [ "$cur" != "$prev" ] && return 1
        prev="$cur"
        n=$((n + 1))
    done
    return 0
}

# Was dae told to bind $1? Read from daed's own configuration (the interface
# lists in its sqlite database, key:"value" text), so the gate and daed agree on
# what is proxied. Same rule as daed-start's must_be_hooked:
#   * wan_interface "auto" means dae binds every interface that is up and carries
#     a default route (common.GetDefaultIfnames) -- every current uplink is
#     proxied, so the probe applies;
#   * a named list binds exactly the names in it, and "auto" is not a name.
# Reading it as "a name must appear" is not enough: with auto the lists name no
# interface at all, and the gate would then close in the very situation it
# exists for -- the uplink having moved to an interface the lists do not mention.
config_binds_iface() {
    [ -f "$DB" ] || return 1
    _cb_wan=$(grep -a -o "$CONFIG_WAN_KEY:\"[^\"]*\"" "$DB" 2>/dev/null | tail -1)
    case "$_cb_wan" in
        *auto*) return 0 ;;
    esac
    for _cb_k in $CONFIG_IFACE_KEYS; do
        _cb_frag=$(grep -a -o "$_cb_k:\"[^\"]*\"" "$DB" 2>/dev/null | tail -1)
        [ -n "$_cb_frag" ] || continue
        case "$_cb_frag" in
            *"$1"*) return 0 ;;
        esac
    done
    return 1
}

# Interfaces carrying a default route right now: the ones traffic can leave by.
# operstate is not usable for this -- Android's rmnet interfaces report
# "unknown" while carrying the default route -- so the routing table is what
# gets read.
default_route_ifaces() {
    ip route show table all 2>/dev/null | grep '^default' \
        | sed -n 's/.*dev \([a-zA-Z0-9_.-]*\).*/\1/p' | sort -u
}

# Skipped only while dae is bound to nothing that is currently an uplink.
#
# This used to read "wlan0 is up and not named in the config", on the assumption
# that Wi-Fi is never a proxied uplink here. That skips the probe in exactly the
# failure this watchdog exists for: the uplink moves to Wi-Fi while dae's tc/eBPF
# hooks stay on the mobile interface it resolved once at startup, so the proxy
# dies silently and the watchdog never looks. "Wi-Fi is up" says nothing about
# which interface traffic leaves by; the default route does.
probe_eligible() {
    _uplinks=$(default_route_ifaces)
    # No default route at all: there is no uplink to judge. Probe anyway, so the
    # datapath is reported inconclusive instead of silently skipped.
    [ -n "$_uplinks" ] || return 0
    for i in $_uplinks; do
        case " $NEVER_UPLINK_IFACES " in
            *" $i "*) continue ;;
        esac
        config_binds_iface "$i" && return 0
    done
    return 1
}

# Resolve $1 to an IPv4 address -- for the CTRL_* target only.
#
# These lookups run in the root shell, and root bypasses dae (uid 0 is exempt in
# the Android patch), so the answer says nothing about the datapath. It is used
# to get an address for the control fetch and for nothing else: a resolver
# answer must never be part of a verdict. 8.8.8.8 goes first, the ISP resolver
# and then the system resolver are the fallbacks, so the control fetch can still
# be made once the proxy is down.
resolve_ipv4() {
    ip=$(resolve_with 8.8.8.8 "$1")
    if [ -n "$ip" ]; then
        printf '%s' "$ip"
        return 0
    fi
    ip=$(resolve_with 223.5.5.5 "$1")
    if [ -n "$ip" ]; then
        printf '%s' "$ip"
        return 0
    fi
    ip=$(resolve_with "" "$1")
    if [ -n "$ip" ]; then
        printf '%s' "$ip"
        return 0
    fi
    return 1
}

resolve_with() {
    if [ -n "$1" ]; then
        busybox nslookup "$2" "$1" 2>/dev/null
    else
        busybox nslookup "$2" 2>/dev/null
    fi | awk '
        /^Name:/ { seen=1; next }
        seen==1 && /^Address [0-9]+:/ {
            for (i=3; i<=NF; i++)
                if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print $i; exit }
        }'
}

# HTTP status of $3 fetched as uid 2000 with an explicit IP (uid 2000 cannot
# use netd's resolver).
http_code_as_shell() {
    su 2000 -c "curl -s -m 12 -o /dev/null -w '%{http_code}' --resolve $1:443:$2 $3" 2>/dev/null
}

# 0 datapath ok, 1 datapath broken, 2 cannot tell (network down, no resolve).
probe_datapath() {
    cip=$(resolve_ipv4 "$CTRL_HOST")
    [ -n "$cip" ] || return 2
    ccode=$(http_code_as_shell "$CTRL_HOST" "$cip" "$CTRL_URL")
    case "$ccode" in
        2*|3*|4*) ;;
        *) return 2 ;;   # uid 2000 has no usable network right now
    esac

    # Each candidate is a real address of PROBE_SNI (see the header), so unlike
    # a resolved name it cannot land in mainland space and be routed direct. The
    # first candidate whose flow reaches dae0 settles it.
    _pd_served=""
    for _pd_ip in $PROBE_IPS; do
        _pd_before=$(dae0_total)
        _pd_code=$(http_code_as_shell "$PROBE_SNI" "$_pd_ip" "$PROBE_URL")
        _pd_after=$(dae0_total)
        [ $(( _pd_after - _pd_before )) -gt 0 ] && return 0
        if [ -z "$_pd_served" ] && [ "$_pd_code" = "$PROBE_EXPECT" ]; then
            _pd_served="$_pd_ip"
        fi
    done

    if [ -n "$_pd_served" ]; then
        # It answered without a single byte crossing dae0: the flow was passed
        # through at the capture point instead of being handed to dae, i.e. it
        # left by an interface dae does not hook -- the stale binding this probe
        # exists for. A working datapath cannot produce this: these addresses are
        # always proxied.
        log "probe: $_pd_served served $PROBE_EXPECT yet dae0 stayed still (traffic bypassed dae)"
        return 1
    fi
    log "probe: no candidate served $PROBE_EXPECT and dae0 stayed still (nothing captured)"
    return 1
}

cooldown_ok() {
    [ -f "$LASTHEAL" ] || return 0
    last=$(cat "$LASTHEAL" 2>/dev/null)
    case "$last" in
        ""|*[!0-9]*) return 0 ;;
    esac
    [ $(( $(date +%s) - last )) -ge "$HEAL_COOLDOWN" ]
}

# Identity of the current boot, used to age out a backoff recorded before a
# reboot. boot_id is the canonical identity, btime the fallback; the write side
# calls this same function, so the two always agree on which source they used.
boot_ident() {
    _bi_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
    [ -n "$_bi_id" ] || _bi_id=$(awk '/^btime/{print $2; exit}' /proc/stat 2>/dev/null)
    printf '%s' "$_bi_id"
}

in_backoff() {
    [ -f "$BACKOFF_UNTIL" ] || return 1
    read -r _ib_boot _ib_until <"$BACKOFF_UNTIL" 2>/dev/null
    # Recorded on an earlier boot -- or in the format that predates the boot id,
    # a bare epoch, which lands in the first field with the second left empty.
    # Either way it was not a verdict about this boot.
    [ "$_ib_boot" = "$(boot_ident)" ] || return 1
    case "$_ib_until" in
        ""|*[!0-9]*) return 1 ;;
    esac
    [ "$(date +%s)" -lt "$_ib_until" ]
}

heal() {
    reason="$1"
    log "repair: $reason"
    date +%s >"$LASTHEAL" 2>/dev/null

    # The stop half of the restart must not claim a user stop. Without this the
    # marker check below would fire on every repair -- daed-stop writes the
    # marker first thing now -- and no repair would ever start a daemon again;
    # and a marker left over from a repair that failed to start silenced this
    # loop for good, its first branch being "switched off by the user".
    DAED_STOP_NO_MARKER=1 "$BIN_DIR/daed-stop" >>"$WLOG" 2>&1

    # The decision to repair was taken from a reading made before that stop ran,
    # and the user may have tapped the tile off in the meantime -- daed-stop
    # then writes the marker before it signals anything. Starting the daemon now
    # would undo their stop, which is the bug this check exists for.
    if [ -f "$MARKER" ]; then
        log "repair aborted: switched off by the user"
        return 0
    fi

    "$BIN_DIR/daed-start" >>"$WLOG" 2>&1

    sleep 5
    # And the same window on the way out: if daed was switched off during the
    # repair, what the probe sees now is the user's doing, not a repair that
    # failed. Recording a backoff here would take the blame for it and mute the
    # next real repair for BACKOFF seconds.
    if [ -f "$MARKER" ]; then
        log "repair outcome: daemon was switched off during the repair"
        return 0
    fi
    if [ "$(probe_datapath; echo $?)" = "0" ]; then
        rm -f "$BACKOFF_UNTIL" 2>/dev/null
        log "repair done: datapath ok (pid=$(daemon_pid))"
    else
        log "repair did not fix the probe -- backing off ${BACKOFF}s"
        echo "$(boot_ident) $(( $(date +%s) + BACKOFF ))" >"$BACKOFF_UNTIL" 2>/dev/null
    fi
}

log "watchdog started (interval=${WATCH_INTERVAL}s, probe=${PROBE_INTERVAL}s, fails=${PROBE_FAILS}, cooldown=${HEAL_COOLDOWN}s, backoff=${BACKOFF}s, never-uplink=[$NEVER_UPLINK_IFACES], marker=$([ -f "$MARKER" ] && echo present || echo absent))"
for k in $CONFIG_IFACE_KEYS; do
    v=$(grep -a -o "$k:\"[^\"]*\"" "$DB" 2>/dev/null | tail -1)
    log "config: ${v:-$k=<not found>}"
done
log "uplinks (default route): [$(printf '%s ' $(default_route_ifaces))]"

probe_fails=0
probe_announced=0
last_probe=0

while true; do
    now=$(date +%s)
    if [ -f "$MARKER" ]; then
        probe_fails=0   # switched off by the user: stay out of the way
    elif [ -z "$(daemon_pid)" ]; then
        heal "daemon not running"
        probe_fails=0
    elif ! ui_ok; then
        heal "web UI not answering on 127.0.0.1:2023"
        probe_fails=0
    elif in_backoff; then
        :               # a previous repair did not help; stay quiet
    elif [ $(( now - last_probe )) -ge "$PROBE_INTERVAL" ]; then
        last_probe=$now
        if probe_eligible; then
            probe_datapath
            rc=$?
            case "$rc" in
                0) if [ "$probe_fails" != "0" ]; then
                       log "datapath probe recovered"
                   elif [ "$probe_announced" != "1" ]; then
                       log "datapath probe ok (traffic goes through dae)"
                       probe_announced=1
                   fi
                   probe_fails=0 ;;
                2) log "datapath probe inconclusive (network/resolve)" ;;
                1) probe_fails=$(( probe_fails + 1 ))
                   log "datapath probe failed (${probe_fails}/${PROBE_FAILS}): traffic is not going through dae"
                   if [ "$probe_fails" -ge "$PROBE_FAILS" ]; then
                       if ! cooldown_ok; then
                           log "repair wanted but cooldown is active"
                       elif dae0_idle; then
                           heal "datapath probe failed ${probe_fails}x"
                           probe_fails=0
                       else
                           log "repair wanted but traffic is flowing; deferring"
                       fi
                   fi ;;
            esac
        else
            _skipped_uplinks=$(printf '%s ' $(default_route_ifaces))
            log "probe skipped: none of the current uplinks is proxied [$_skipped_uplinks]"
            probe_fails=0
        fi
    fi

    [ "$ONCE" = "1" ] && exit 0
    sleep "$WATCH_INTERVAL"
done
