+// isRawIPInterface reports whether the interface's ARPHRD type is RAWIP (519),
+// i.e. a link with no L2 header such as Android's cellular RmNet devices.
+func isRawIPInterface(ifname string) bool {
+	b, err := os.ReadFile("/sys/class/net/" + ifname + "/type")
+	if err != nil {
+		return false
+	}
+	typ, err := strconv.Atoi(strings.TrimSpace(string(b)))
+	if err != nil {
+		return false
+	}
+	return typ == int(unix.ARPHRD_RAWIP)
+}
