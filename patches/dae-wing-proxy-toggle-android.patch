+// proxyMarkerPath mirrors the dae proxy "running" state to a marker file on
+// disk so the Android Quick-Settings tile can read it with a cheap `test -f`
+// instead of querying the GraphQL API. Presence of the file means the proxy is
+// stopped; absence means it is running. The path matches the dae Magisk
+// module's config dir (`-c /data/adb/daed`).
+const proxyMarkerPath = "/data/adb/daed/.dae-stopped"
+
+// MarkProxyStopped writes the marker (proxy stopped). Failure is non-fatal:
+// the dae proxy state itself is tracked in the database.
+func MarkProxyStopped() {
+	if err := os.WriteFile(proxyMarkerPath, nil, 0644); err != nil {
+		logrus.Warnln("Failed to write proxy-stopped marker:", err)
+	}
+}
+
+// MarkProxyRunning removes the marker (proxy running).
+func MarkProxyRunning() {
+	if err := os.Remove(proxyMarkerPath); err != nil && !os.IsNotExist(err) {
+		logrus.Warnln("Failed to remove proxy-stopped marker:", err)
+	}
+}
