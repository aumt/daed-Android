+// toggleProxy starts (run=true) or stops (run=false) the dae proxy through the
+// same code path as the GraphQL run mutation, so the DB running flag and the
+// proxy-stopped marker stay consistent. The daed web UI keeps running.
+func toggleProxy(run bool) error {
+	tx := db.BeginTx(context.TODO())
+	if _, err := config.Run(tx, !run); err != nil {
+		tx.Rollback()
+		return err
+	}
+	return tx.Commit().Error
+}
+
+// syncProxyMarker mirrors the DB running flag to the proxy-stopped marker at
+// startup. When the last state was "stopped", restoreRunningState does not run
+// the proxy and therefore never touches the marker; write it here so the
+// Quick-Settings tile reports the correct state after a reboot.
+func syncProxyMarker() {
+	tx := db.BeginTx(context.TODO())
+	defer tx.Commit()
+	var sys db.System
+	if err := tx.Model(&db.System{}).FirstOrCreate(&sys).Error; err != nil {
+		logrus.Warnln("Failed to read running state for marker sync:", err)
+		return
+	}
+	if sys.Running {
+		config.MarkProxyRunning()
+	} else {
+		config.MarkProxyStopped()
+	}
+}
