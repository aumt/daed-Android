+// resolveCheckNetworkHost resolves addr's hostname via explicit DNS instead of
+// the Go net.Resolver. On Android there is no /etc/resolv.conf (netd owns DNS),
+// so the pure-Go resolver cannot look up hostnames and every attempt fails. We
+// fall back to the configured fallback resolver (8.8.8.8:53) which works even
+// before any dae routing is installed.
+func resolveCheckNetworkHost(ctx context.Context, addr string) (string, error) {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil {
+		return "", err
+	}
+	if net.ParseIP(host) != nil {
+		return addr, nil
+	}
+	dns := netutils.FallbackDns
+	if !dns.IsValid() {
+		dns = netip.MustParseAddrPort("8.8.8.8:53")
+	}
+	ip46, err4, err6 := netutils.ResolveIp46(ctx, direct.SymmetricDirect, dns, host, "udp", false)
+	ip := ip46.Ip4
+	if !ip.IsValid() {
+		ip = ip46.Ip6
+	}
+	if !ip.IsValid() {
+		return "", fmt.Errorf("resolve %v via explicit DNS failed (err4=%v, err6=%v)", host, err4, err6)
+	}
+	return net.JoinHostPort(ip.String(), port), nil
+}
