-KMAJOR=$(uname -r | cut -d. -f1)
-KMINOR=$(uname -r | cut -d. -f2)
-if [ "$KMAJOR" -lt 5 ] 2>/dev/null || { [ "$KMAJOR" -eq 5 ] && [ "$KMINOR" -lt 17 ]; } 2>/dev/null; then
