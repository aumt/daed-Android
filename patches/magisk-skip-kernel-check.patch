+# comparison is not a reliable gate and is intentionally not enforced here.
+ui_print "Kernel $(uname -r) - version check skipped (nokernelcheck build)"
 
 # Set executable permissions for binaries
 # Magisk overlays system/ onto /system automatically, no manual copy needed
diff --git a/android/magisk/service.sh b/android/magisk/service.sh
