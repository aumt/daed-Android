diff --git a/cmd/run.go b/cmd/run.go
index 2ad7bfb..db998fd 100644
--- a/cmd/run.go
+++ b/cmd/run.go
@@ -112,7 +112,11 @@ var (
 			}()
 			// Reload with running state.
 			if err := restoreRunningState(); err != nil {
-				logrus.Warnln("Failed to restore last running state:", err)
+				// Error, not Warn: a failure here means the "last running"
+				// state was not written to the DB, so the next boot may come
+				// up with a different config than the one the user left
+				// behind -- silently, until it happens.
+				logrus.Errorln("Failed to restore last running state:", err)
 			}
 			// Sync the proxy-stopped marker so the Quick-Settings tile reports
 			// the right state after a reboot.
@@ -192,10 +196,17 @@ func restoreRunningState() (err error) {
 			tx2.Rollback()
 			return fmt.Errorf("%w; %v", err, err2)
 		}
-		tx2.Commit()
+		if err2 := tx2.Commit(); err2 != nil {
+			return fmt.Errorf("%w; commit running=false: %v", err, err2)
+		}
 		return err
 	}
-	tx.Commit()
+	if err := tx.Commit(); err != nil {
+		// Dropping this error left a failed write invisible: the daemon kept
+		// serving the config it had just loaded while the DB still described
+		// the previous state, and the only symptom appeared after a reboot.
+		return fmt.Errorf("commit running state: %w", err)
+	}
 	return nil
 }
 
